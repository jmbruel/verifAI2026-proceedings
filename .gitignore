.kiro

# Camera-ready / compiled PDFs and ZIP archives in papers/ (any depth)
# Add explicitly with `git add -f` if you need to version a specific PDF.
# Note: .tex, .bib, .bbl, figure images (.png/.jpg/.eps), and .docx are NOT ignored
# because Springer requires all paper source files.
papers/*.pdf
papers/**/*.pdf
papers/*.zip
papers/**/*.zip

